# ==============================================================================
#  aws-eventbridge — terraform.tfvars
# ==============================================================================
#  Copy this file to `terraform.tfvars`, set the values, then run:
#      tofu init && tofu apply        (or:  terraform init && terraform apply)
#
# AUTHENTICATION — AWS:
#   The AWS provider authenticates exactly like the AWS SDK/CLI, resolving
#   credentials through a fixed precedence chain and (separately) requiring a
#   region.
#   Quick start: aws sso login --profile <name> (or `aws configure sso`
#   first-time setup; `aws configure` for static keys). The SDK/Terraform read
#   the SSO/credential cache automatically.
#   Environment variables Terraform reads:
#     AWS_ACCESS_KEY_ID  (secret) — Access key ID for static/temporary credentials.
#     AWS_SECRET_ACCESS_KEY  (secret) — Secret access key paired with the access key ID.
#     AWS_SESSION_TOKEN  (secret) — Session token for temporary (STS) credentials.
#     AWS_REGION — Target AWS region (required); preferred over AWS_DEFAULT_REGION.
#     AWS_DEFAULT_REGION — Legacy region variable; used if AWS_REGION is unset.
#   Full guide (auth + remote state):  docs/CONNECTING-PROVIDERS.md#aws
#
#  Secrets below read "REPLACE_ME" — never commit real secrets. Prefer
#  TF_VAR_<name> environment variables or a secrets manager.
#  Status: static-validated, live-test pending (see README.md).
# ==============================================================================


# ------------------------------------------------------------------------------
#  REQUIRED — you must set these
# ------------------------------------------------------------------------------

# bus_name  —  string  (REQUIRED)
#   Name of the custom EventBridge event bus to create. Cannot be 'default'
#   (that is the account's built-in bus).
#   Constraint: bus_name must be 1-256 characters of [a-zA-Z0-9._-] and cannot
#   be 'default'.
bus_name = "iacbazaar-example-orders"

# ------------------------------------------------------------------------------
#  OPTIONAL — defaults shown; uncomment a line to override
# ------------------------------------------------------------------------------

# bus_description  —  string  (optional, default: null)
#   Optional description for the event bus (max 512 characters).
# bus_description = null

# bus_kms_key_identifier  —  string  (optional, default: null)
#   Customer-managed KMS key (id or ARN) used to encrypt events at rest on the
#   bus. Null = the AWS-owned EventBridge key (still encrypted at rest, no extra
#   cost). A CMK's key policy must grant EventBridge (events.amazonaws.com)
#   kms:GenerateDataKey*/kms:Decrypt.
# bus_kms_key_identifier = null

# bus_dead_letter_arn  —  string  (optional, default: null)
#   Optional SQS queue ARN for the bus-level dead-letter queue. The queue policy
#   must allow events.amazonaws.com to sqs:SendMessage. Null = no bus DLQ.
# bus_dead_letter_arn = null

# rule_name  —  string  (optional, default: null)
#   Name of the rule on the bus. Null = <bus_name>-rule. Rule names are unique
#   per bus (max 64 characters).
# rule_name = null

# rule_description  —  string  (optional, default: null)
#   Optional description for the rule (max 512 characters).
# rule_description = "Capture order events for auditing"

# event_pattern  —  string  (optional, default: null)
#   EventBridge event pattern as a JSON string. Rules on a CUSTOM bus must
#   filter by event pattern. Null = a catch-all that matches every event from
#   this account delivered to the bus.
#   Constraint: event_pattern must be valid JSON.
# event_pattern = "{\"source\":[\"my.app\"],\"detail-type\":[\"OrderPlaced\"]}"

# rule_state  —  string  (optional, default: "ENABLED")
#   Rule state: ENABLED, DISABLED, or
#   ENABLED_WITH_ALL_CLOUDTRAIL_MANAGEMENT_EVENTS.
# rule_state = "ENABLED"

# target_type  —  string  (optional, default: "log_group")
#   Where matched events are sent. 'log_group' creates a CloudWatch Logs group
#   plus its resource policy (self-contained, free). 'external' sends to the ARN
#   in target_arn (SQS, SNS, Lambda, Step Functions, ...).
#   Constraint: target_type must be log_group or external.
# target_type = "log_group"

# target_id  —  string  (optional, default: "primary")
#   Stable identifier for the target within the rule.
#   Constraint: target_id must be 1-64 characters of [a-zA-Z0-9._-].
# target_id = "primary"

# target_arn  —  string  (optional, default: null)
#   ARN of the destination when target_type = external. Ignored for
#   target_type = log_group.
# target_arn = "arn:aws:sqs:us-east-1:123456789012:orders"

# target_role_arn  —  string  (optional, default: null)
#   Optional IAM role ARN EventBridge assumes to deliver to the target (required
#   for some external targets such as Step Functions/Kinesis/ECS).
# target_role_arn = null

# target_input  —  string  (optional, default: null)
#   Optional static JSON passed to the target instead of the matched event.
#   Constraint: target_input must be valid JSON.
# target_input = null

# target_dead_letter_arn  —  string  (optional, default: null)
#   Optional SQS queue ARN for the target-level dead-letter queue. The queue
#   policy must allow events.amazonaws.com to sqs:SendMessage. Null = no DLQ.
# target_dead_letter_arn = null

# target_maximum_event_age_in_seconds  —  number  (optional, default: 86400)
#   Maximum age of an event EventBridge will keep retrying before discarding it.
#   Constraint: target_maximum_event_age_in_seconds must be between 60 and 86400.
# target_maximum_event_age_in_seconds = 86400

# target_maximum_retry_attempts  —  number  (optional, default: 185)
#   Maximum number of delivery retry attempts.
#   Constraint: target_maximum_retry_attempts must be between 0 and 185.
# target_maximum_retry_attempts = 185

# log_group_name  —  string  (optional, default: null)
#   Name of the CloudWatch Logs group to create as the target. Null =
#   /aws/events/<bus_name>. Only used when target_type = log_group.
# log_group_name = null

# log_retention_days  —  number  (optional, default: 14)
#   Retention for the target log group (days). 0 = never expire. Only used when
#   target_type = log_group.
#   Constraint: must be a value CloudWatch Logs accepts (0, 1, 3, 5, 7, 14, 30,
#   60, 90, 120, 150, 180, 365, 400, 545, 731, 1096, 1827, 2192, 2557, 2922,
#   3288, 3653).
# log_retention_days = 14

# log_kms_key_id  —  string  (optional, default: null)
#   Customer-managed KMS key ARN to encrypt the target log group. Null =
#   AWS-managed CloudWatch Logs encryption. Only used when target_type =
#   log_group.
# log_kms_key_id = null

# tags  —  map(string)  (optional, default: {})
#   Tags applied to all resources that support tagging (bus, rule, log group).
tags = {
  Environment = "example"
  ManagedBy   = "iac-bazaar"
}
